# Copie para .env:  cp .env.example .env

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Banco e Redis (valores do docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/btc_invest
DATABASE_LOGGING=false
REDIS_URL=redis://localhost:6379

# Usado só pelos testes e2e (as tabelas desse banco são apagadas!)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/btc_invest_test
TEST_REDIS_URL=redis://localhost:6379/1

# Segurança: troque o segredo (mínimo 32 caracteres). Ex.: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-32+
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
CORS_ORIGIN=*
RATE_LIMIT_MAX=100

# Cotação: "mercadobitcoin" (API real) ou "fake" (offline, para desenvolvimento)
QUOTE_PROVIDER=mercadobitcoin
QUOTE_URL=https://www.mercadobitcoin.net/api/BTC/ticker/
QUOTE_TIMEOUT_MS=5000
QUOTE_CACHE_TTL_SECONDS=10

# E-mail: sem SENDGRID_API_KEY os e-mails são apenas registrados no log do worker
SENDGRID_API_KEY=
MAIL_FROM=no-reply@seudominio.com

# Fuso usado no "dia corrente" do /volume e nos agendamentos
APP_TIMEZONE=America/Sao_Paulo
