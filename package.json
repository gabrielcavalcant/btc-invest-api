{
  "name": "btc-invest-api",
  "version": "1.0.0",
  "description": "API de investimento em Bitcoin (desafio técnico backend)",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/infra/database/migrate.ts",
    "migrate:prod": "node dist/infra/database/migrate.js",
    "test": "tsx --test \"test/unit/**/*.test.ts\"",
    "demo:swagger": "tsx test/visual/swagger-demo.ts",
    "test:e2e": "tsx --test --test-concurrency=1 \"test/e2e/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^5.2.6",
    "@sendgrid/mail": "^8.1.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
