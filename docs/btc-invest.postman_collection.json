{
  "info": {
    "name": "BTC Invest API",
    "description": "Run the requests in order (or the whole collection with the Runner). \"Create Account\" generates a new e-mail on each run and \"Login\" stores the JWT in the {{token}} variable, used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "apiUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "investor123" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{apiUrl}}/health", "host": ["{{apiUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Create Account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// new e-mail on each run, so the collection can be run again",
                  "pm.collectionVariables.set('email', `investor+${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('returns the account id', () => pm.expect(pm.response.json().id).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fulano da Silva\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{apiUrl}}/account", "host": ["{{apiUrl}}"], "path": ["account"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const { token } = pm.response.json();",
                  "pm.test('returns a JWT', () => pm.expect(token).to.be.a('string'));",
                  "// used by every authenticated request (collection auth: Bearer {{token}})",
                  "pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{apiUrl}}/login", "host": ["{{apiUrl}}"], "path": ["login"] }
          }
        },
        {
          "name": "Deposit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('balance includes the deposit', () => pm.expect(pm.response.json().balance).to.eql('1000.00'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{apiUrl}}/account/deposit",
              "host": ["{{apiUrl}}"],
              "path": ["account", "deposit"]
            }
          }
        },
        {
          "name": "Balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the balance', () => pm.expect(pm.response.json().balance).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/account/balance",
              "host": ["{{apiUrl}}"],
              "path": ["account", "balance"]
            }
          }
        }
      ]
    },
    {
      "name": "BTC",
      "item": [
        {
          "name": "Get Price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns buy and sell', () => pm.expect(pm.response.json()).to.have.keys('buy', 'sell', 'date'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/btc/price",
              "host": ["{{apiUrl}}"],
              "path": ["btc", "price"]
            }
          }
        },
        {
          "name": "Purchase",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('R$ 500 left in the balance', () => pm.expect(pm.response.json().balance).to.eql('500.00'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{apiUrl}}/btc/purchase",
              "host": ["{{apiUrl}}"],
              "path": ["btc", "purchase"]
            }
          }
        },
        {
          "name": "Position",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('lists the investment', () => pm.expect(pm.response.json().investments).to.have.lengthOf(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiUrl}}/btc", "host": ["{{apiUrl}}"], "path": ["btc"] }
          }
        },
        {
          "name": "Sell",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('partial sale reinvests the residual', () => pm.expect(pm.response.json().reinvestment).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "description": "Partial sale: the investment is fully liquidated and the residual is reinvested at the original quote (SELL + REINVESTMENT in the statement).",
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 200\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{apiUrl}}/btc/sell", "host": ["{{apiUrl}}"], "path": ["btc", "sell"] }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Extract (last 90 days)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const types = pm.response.json().items.map((i) => i.type);",
                  "pm.test('has deposit, purchase, sell and reinvestment', () =>",
                  "  pm.expect(types).to.include.members(['DEPOSIT', 'PURCHASE', 'SELL', 'REINVESTMENT']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiUrl}}/extract", "host": ["{{apiUrl}}"], "path": ["extract"] }
          }
        },
        {
          "name": "Extract (custom range)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// last 7 days, as plain dates (YYYY-MM-DD); \"to\" includes the whole day",
                  "const day = (d) => d.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('from', day(new Date(Date.now() - 7 * 864e5)));",
                  "pm.collectionVariables.set('to', day(new Date(Date.now() + 864e5)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the items', () => pm.expect(pm.response.json().items).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/extract?from={{from}}&to={{to}}",
              "host": ["{{apiUrl}}"],
              "path": ["extract"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            }
          }
        },
        {
          "name": "Volume",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns buy and sell', () => pm.expect(pm.response.json()).to.include.keys('buy', 'sell'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiUrl}}/volume", "host": ["{{apiUrl}}"], "path": ["volume"] }
          }
        },
        {
          "name": "History",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns a list', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{apiUrl}}/history", "host": ["{{apiUrl}}"], "path": ["history"] }
          }
        }
      ]
    }
  ]
}
